# Banco de dados
POSTGRES_USER=training
POSTGRES_PASSWORD=training
POSTGRES_DB=training
DATABASE_URL=postgresql+psycopg://training:training@localhost:5432/training

# Frontend permitido no CORS
CORS_ORIGINS=["http://localhost:5173"]

# Fuso usado para definir o dia de cada atividade
TIMEZONE=America/Sao_Paulo

# Garmin Connect Personal API
# Crie a chave em https://connect.garmin.com/app/settings/personalApiToken
GARMIN_PERSONAL_API_KEY=
