# Banco de dados
POSTGRES_USER=training
POSTGRES_PASSWORD=training
POSTGRES_DB=training
DATABASE_URL=postgresql+psycopg://training:training@localhost:5432/training

# Frontend permitido no CORS
CORS_ORIGINS=["http://localhost:5173"]

# Fuso usado para definir o dia de cada atividade
TIMEZONE=America/Sao_Paulo

# Dia em que a semana de treino começa (0 = segunda, 1 = terça ... 6 = domingo)
WEEK_START_WEEKDAY=1

# Garmin Connect Personal API
# Crie a chave em https://connect.garmin.com/app/settings/personalApiToken
GARMIN_PERSONAL_API_KEY=

# IA para avaliar a semana e ler treinos em qualquer formato: qualquer API compatível com
# OpenAI. Padrão: Ollama no próprio Mac (`ollama pull deepseek-r1:8b`), visto de dentro do Docker.
# Ollama do docker compose (--profile ollama): AI_BASE_URL=http://ollama:11434/v1
# Sem Docker: AI_BASE_URL=http://localhost:11434/v1
# DeepSeek na nuvem: AI_BASE_URL=https://api.deepseek.com, AI_API_KEY e AI_MODEL da conta.
AI_BASE_URL=http://host.docker.internal:11434/v1
AI_API_KEY=
AI_MODEL=deepseek-r1:8b
