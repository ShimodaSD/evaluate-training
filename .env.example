# Banco de dados
POSTGRES_USER=training
POSTGRES_PASSWORD=training
POSTGRES_DB=training
DATABASE_URL=postgresql+psycopg://training:training@localhost:5432/training

# Frontend permitido no CORS
CORS_ORIGINS=["http://localhost:5173"]

# Fuso usado para definir o dia de cada atividade
TIMEZONE=America/Sao_Paulo

# Dia em que a semana de treino começa (0 = segunda, 1 = terça ... 6 = domingo)
WEEK_START_WEEKDAY=1

# Garmin Connect Personal API
# Crie a chave em https://connect.garmin.com/app/settings/personalApiToken
GARMIN_PERSONAL_API_KEY=

# IA: avaliação da semana e leitura de treinos em qualquer formato. AI_PROVIDER=gemini ou anthropic
AI_PROVIDER=gemini
# Gemini: chave grátis em https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Claude: chave em https://platform.claude.com/settings/keys (pago)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
